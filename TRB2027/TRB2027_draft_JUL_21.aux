\@writefile{toc}{\contentsline {subsection}{\numberline {5.1}Ideal asset-specific reference}{11}{subsection.5.1}\protected@file@percent }
\newlabel{sec:oracle-results}{{5.1}{11}{Ideal asset-specific reference}{subsection.5.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Ideal asset-specific detector performance on CWRU. Values are mean $\pm $ standard deviation across the four operating conditions. Each detector is trained and calibrated separately using the complete healthy dataset of the corresponding condition.\relax }}{11}{table.caption.11}\protected@file@percent }
\newlabel{tab:asset-specific-summary}{{1}{11}{Ideal asset-specific detector performance on CWRU. Values are mean $\pm $ standard deviation across the four operating conditions. Each detector is trained and calibrated separately using the complete healthy dataset of the corresponding condition.\relax }{table.caption.11}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.2}Repeated-run stability of the asset-specific autoencoder}{11}{subsection.5.2}\protected@file@percent }
\newlabel{sec:ae-stability}{{5.2}{11}{Repeated-run stability of the asset-specific autoencoder}{subsection.5.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Repeated-run stability of the asset-specific autoencoder over five independent random initializations. Detection performance is unchanged across runs, whereas the absolute reconstruction threshold varies slightly.\relax }}{12}{table.caption.12}\protected@file@percent }
\newlabel{tab:ae-stability}{{2}{12}{Repeated-run stability of the asset-specific autoencoder over five independent random initializations. Detection performance is unchanged across runs, whereas the absolute reconstruction threshold varies slightly.\relax }{table.caption.12}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.3}Direct simulation-to-field deployment}{12}{subsection.5.3}\protected@file@percent }
\newlabel{sec:shared-deployment-results}{{5.3}{12}{Direct simulation-to-field deployment}{subsection.5.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Simulation-to-field deployment of the shared autoencoder on CWRU. FAR denotes the healthy false-alarm rate and DR the fault detection rate. The field-oracle radius uses every available healthy window; the online radius uses only the first 100 healthy windows. A dash indicates that convergence is not applicable because the threshold is computed directly rather than estimated sequentially.\relax }}{12}{table.caption.13}\protected@file@percent }
\newlabel{tab:shared-deployment}{{3}{12}{Simulation-to-field deployment of the shared autoencoder on CWRU. FAR denotes the healthy false-alarm rate and DR the fault detection rate. The field-oracle radius uses every available healthy window; the online radius uses only the first 100 healthy windows. A dash indicates that convergence is not applicable because the threshold is computed directly rather than estimated sequentially.\relax }{table.caption.13}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.4}Cost of scalable deployment}{13}{subsection.5.4}\protected@file@percent }
\newlabel{sec:deployment-cost}{{5.4}{13}{Cost of scalable deployment}{subsection.5.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Ideal but non-scalable asset-specific deployment versus the proposed fleet-scalable deployment. Values are mean $\pm $ standard deviation across the four CWRU operating conditions.\relax }}{13}{table.caption.14}\protected@file@percent }
\newlabel{tab:oracle-vs-proposed}{{4}{13}{Ideal but non-scalable asset-specific deployment versus the proposed fleet-scalable deployment. Values are mean $\pm $ standard deviation across the four CWRU operating conditions.\relax }{table.caption.14}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.5}Operational-radius convergence}{13}{subsection.5.5}\protected@file@percent }
\newlabel{sec:radius-convergence-results}{{5.5}{13}{Operational-radius convergence}{subsection.5.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Cold-start convergence and retrospective evolution of the local operational radius across the four CWRU operating conditions. The blue segment shows the sequential radius estimate during the 100-window calibration interval used by the deployed detector. The red dotted line marks the detected convergence index, and the blue dash-dotted line marks the end of the prescribed cold-start interval. The gray segment is a retrospective cumulative estimate obtained by continuing to incorporate the remaining known-healthy observations; it is shown only to characterize the subsequent evolution of the estimator and is not used to update the deployed decision boundary. Horizontal lines indicate the transferred standardized radius $\tau _{\mathrm  {bridge}}$ and the complete-data field p98 reference.\relax }}{14}{figure.caption.15}\protected@file@percent }
\newlabel{fig:tau-convergence}{{5}{14}{Cold-start convergence and retrospective evolution of the local operational radius across the four CWRU operating conditions. The blue segment shows the sequential radius estimate during the 100-window calibration interval used by the deployed detector. The red dotted line marks the detected convergence index, and the blue dash-dotted line marks the end of the prescribed cold-start interval. The gray segment is a retrospective cumulative estimate obtained by continuing to incorporate the remaining known-healthy observations; it is shown only to characterize the subsequent evolution of the estimator and is not used to update the deployed decision boundary. Horizontal lines indicate the transferred standardized radius $\tau _{\mathrm {bridge}}$ and the complete-data field p98 reference.\relax }{figure.caption.15}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.6}Robustness to local initialization}{15}{subsection.5.6}\protected@file@percent }
\newlabel{sec:initialization-robustness}{{5.6}{15}{Robustness to local initialization}{subsection.5.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Robustness of online operational-radius estimation under different random warm-up samples. The shared simulator-trained representation remained fixed throughout the experiment. Only the 100 healthy initialization windows used for local calibration were randomly changed. Values are mean $\pm $ standard deviation over five random seeds.\relax }}{15}{table.caption.16}\protected@file@percent }
\newlabel{tab:initialization-robustness}{{5}{15}{Robustness of online operational-radius estimation under different random warm-up samples. The shared simulator-trained representation remained fixed throughout the experiment. Only the 100 healthy initialization windows used for local calibration were randomly changed. Values are mean $\pm $ standard deviation over five random seeds.\relax }{table.caption.16}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.7}Multi-unit run-to-failure validation on NASA IMS}{16}{subsection.5.7}\protected@file@percent }
\newlabel{sec:nasa-results}{{5.7}{16}{Multi-unit run-to-failure validation on NASA IMS}{subsection.5.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Recording-level run-to-failure validation on NASA IMS using the shared nominal representation and local operational-radius calibration. Lead time is measured relative to the documented end of the experiment.\relax }}{16}{table.caption.17}\protected@file@percent }
\newlabel{tab:nasa-main-results}{{6}{16}{Recording-level run-to-failure validation on NASA IMS using the shared nominal representation and local operational-radius calibration. Lead time is measured relative to the documented end of the experiment.\relax }{table.caption.17}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {5.7.1}Stability of local operational-radius estimation}{16}{subsubsection.5.7.1}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Stability of local operational-radius estimation for the shared NASA representation under different warm-up initializations.\relax }}{17}{table.caption.18}\protected@file@percent }
\newlabel{tab:nasa-stability}{{7}{17}{Stability of local operational-radius estimation for the shared NASA representation under different warm-up initializations.\relax }{table.caption.18}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {5.7.2}Comparison with per-asset early-life training}{17}{subsubsection.5.7.2}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces NASA IMS comparison between the proposed shared representation and autoencoders trained separately on the early-life data of each bearing. Asset-specific results are mean $\pm $ standard deviation over five training initializations. Shared-model values correspond to one fixed representation applied unchanged to every bearing. Lead time is measured relative to the documented end of the experiment.\relax }}{17}{table.caption.19}\protected@file@percent }
\newlabel{tab:nasa-shared-vs-specific}{{8}{17}{NASA IMS comparison between the proposed shared representation and autoencoders trained separately on the early-life data of each bearing. Asset-specific results are mean $\pm $ standard deviation over five training initializations. Shared-model values correspond to one fixed representation applied unchanged to every bearing. Lead time is measured relative to the documented end of the experiment.\relax }{table.caption.19}{}}
