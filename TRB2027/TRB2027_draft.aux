\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Ideal asset-specific detector performance on CWRU. Values are mean $\pm $ standard deviation across the four operating conditions. Each detector is trained and calibrated separately using the complete healthy dataset of the corresponding condition.\relax }}{10}{table.caption.9}\protected@file@percent }
