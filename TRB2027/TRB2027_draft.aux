\@writefile{toc}{\contentsline {subsection}{\numberline {5.3}Direct simulation-to-field deployment}{10}{subsection.5.3}\protected@file@percent }
\newlabel{sec:shared-deployment-results}{{5.3}{10}{Direct simulation-to-field deployment}{subsection.5.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Simulation-to-field deployment of the shared autoencoder on CWRU. FAR denotes healthy false-alarm rate and DR denotes fault detection rate. The field oracle uses every available healthy window, whereas the proposed online procedure stops automatically when the empirical p98 radius satisfies the convergence criterion. Healthy FAR is evaluated over the complete healthy sequence to permit direct comparison between calibration strategies, including observations used during commissioning. A dash indicates that sequential calibration is not applicable.\relax }}{11}{table.caption.9}\protected@file@percent }
\newlabel{tab:shared-deployment}{{3}{11}{Simulation-to-field deployment of the shared autoencoder on CWRU. FAR denotes healthy false-alarm rate and DR denotes fault detection rate. The field oracle uses every available healthy window, whereas the proposed online procedure stops automatically when the empirical p98 radius satisfies the convergence criterion. Healthy FAR is evaluated over the complete healthy sequence to permit direct comparison between calibration strategies, including observations used during commissioning. A dash indicates that sequential calibration is not applicable.\relax }{table.caption.9}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.4}Cost of scalable deployment}{11}{subsection.5.4}\protected@file@percent }
\newlabel{sec:deployment-cost}{{5.4}{11}{Cost of scalable deployment}{subsection.5.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Ideal but non-scalable asset-specific deployment versus the proposed fleet-scalable deployment. Values are mean $\pm $ standard deviation across the four CWRU operating conditions. The shared field-oracle strategy uses the complete healthy dataset only to estimate the local radius; it does not retrain the shared representation.\relax }}{12}{table.caption.10}\protected@file@percent }
\newlabel{tab:oracle-vs-proposed}{{4}{12}{Ideal but non-scalable asset-specific deployment versus the proposed fleet-scalable deployment. Values are mean $\pm $ standard deviation across the four CWRU operating conditions. The shared field-oracle strategy uses the complete healthy dataset only to estimate the local radius; it does not retrain the shared representation.\relax }{table.caption.10}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Agreement between the converged online operational radius and the complete-data field-oracle p98 reference. Relative difference is computed as $100|\tau _{\mathrm  {online}}-\tau _{\mathrm  {oracle}}|/ \tau _{\mathrm  {oracle}}$. Post-calibration FAR is evaluated only on healthy windows occurring after the declared convergence point.\relax }}{12}{table.caption.11}\protected@file@percent }
\newlabel{tab:online-oracle-agreement}{{5}{12}{Agreement between the converged online operational radius and the complete-data field-oracle p98 reference. Relative difference is computed as $100|\tau _{\mathrm {online}}-\tau _{\mathrm {oracle}}|/ \tau _{\mathrm {oracle}}$. Post-calibration FAR is evaluated only on healthy windows occurring after the declared convergence point.\relax }{table.caption.11}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.5}Operational-radius convergence}{12}{subsection.5.5}\protected@file@percent }
\newlabel{sec:radius-convergence-results}{{5.5}{12}{Operational-radius convergence}{subsection.5.5}{}}
\newlabel{eq:tau-online-p98}{{3}{13}{Operational-radius convergence}{equation.5.3}{}}
\newlabel{eq:convergence}{{4}{13}{Operational-radius convergence}{equation.5.4}{}}
\newlabel{eq:tau-field-p98}{{5}{13}{Operational-radius convergence}{equation.5.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Sequential estimation of the empirical p98 operational radius during CWRU commissioning. For each operating condition, the blue segment shows the online estimate defined in Eq.\nobreakspace  {}\eqref  {eq:tau-online-p98}, $\tau _k(t)=\setbox \z@ \hbox {\mathsurround \z@ $\textstyle Q$}\mathaccent "0362{Q}_{k,t}(0.98)$, until the convergence criterion is satisfied. The red dotted line marks the declared convergence point, at which the operational radius is frozen and active monitoring begins. The gray segment is a retrospective continuation obtained by incorporating additional observations known from the benchmark to be healthy; it is shown only to characterize the subsequent behaviour of the estimator and is not used to modify the deployed operational radius. The horizontal dashed line indicates the complete-data field-oracle reference defined in Eq.\nobreakspace  {}\eqref  {eq:tau-field-p98}.\relax }}{14}{figure.caption.12}\protected@file@percent }
\newlabel{fig:tau-convergence}{{2}{14}{Sequential estimation of the empirical p98 operational radius during CWRU commissioning. For each operating condition, the blue segment shows the online estimate defined in Eq.~\eqref {eq:tau-online-p98}, $\tau _k(t)=\widehat {Q}_{k,t}(0.98)$, until the convergence criterion is satisfied. The red dotted line marks the declared convergence point, at which the operational radius is frozen and active monitoring begins. The gray segment is a retrospective continuation obtained by incorporating additional observations known from the benchmark to be healthy; it is shown only to characterize the subsequent behaviour of the estimator and is not used to modify the deployed operational radius. The horizontal dashed line indicates the complete-data field-oracle reference defined in Eq.~\eqref {eq:tau-field-p98}.\relax }{figure.caption.12}{}}
