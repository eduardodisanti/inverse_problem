\newlabel{sec:deployment-cost}{{5.4}{12}{Cost of scalable deployment}{subsection.5.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Ideal but non-scalable asset-specific deployment versus the proposed fleet-scalable deployment. Values are mean $\pm $ standard deviation across the four CWRU operating conditions.\relax }}{13}{table.caption.11}\protected@file@percent }
\newlabel{tab:oracle-vs-proposed}{{4}{13}{Ideal but non-scalable asset-specific deployment versus the proposed fleet-scalable deployment. Values are mean $\pm $ standard deviation across the four CWRU operating conditions.\relax }{table.caption.11}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Agreement between the converged online operational radius and the complete-data field-oracle p98 reference. Relative difference is computed as $100|\tau _{\mathrm  {online}}-\tau _{\mathrm  {oracle}}|/ \tau _{\mathrm  {oracle}}$. Post-calibration FAR is evaluated only on healthy windows occurring after the declared convergence point.\relax }}{13}{table.caption.12}\protected@file@percent }
\newlabel{tab:online-oracle-agreement}{{5}{13}{Agreement between the converged online operational radius and the complete-data field-oracle p98 reference. Relative difference is computed as $100|\tau _{\mathrm {online}}-\tau _{\mathrm {oracle}}|/ \tau _{\mathrm {oracle}}$. Post-calibration FAR is evaluated only on healthy windows occurring after the declared convergence point.\relax }{table.caption.12}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.5}Operational-radius convergence}{13}{subsection.5.5}\protected@file@percent }
\newlabel{sec:radius-convergence-results}{{5.5}{13}{Operational-radius convergence}{subsection.5.5}{}}
\newlabel{eq:tau-online-p98}{{13}{13}{Operational-radius convergence}{equation.5.13}{}}
\newlabel{eq:tau-field-p98}{{14}{14}{Operational-radius convergence}{equation.5.14}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Sequential estimation of the empirical p98 operational radius during CWRU commissioning. For each operating condition, the blue segment shows the online estimate $\tau _k(t)=\setbox \z@ \hbox {\mathsurround \z@ $\textstyle Q$}\mathaccent "0362{Q}_{k,t}(0.98)$ until the convergence criterion is satisfied. The red dotted line marks the declared convergence point, at which the operational radius is frozen and active monitoring begins. The gray segment is a retrospective continuation obtained by incorporating additional observations known from the benchmark to be healthy; it is shown only to characterize the subsequent behaviour of the estimator and is not used to modify the deployed decision boundary. The horizontal dashed line indicates the complete-data field-oracle p98 reference.\relax }}{14}{figure.caption.13}\protected@file@percent }
\newlabel{fig:tau-convergence}{{3}{14}{Sequential estimation of the empirical p98 operational radius during CWRU commissioning. For each operating condition, the blue segment shows the online estimate $\tau _k(t)=\widehat {Q}_{k,t}(0.98)$ until the convergence criterion is satisfied. The red dotted line marks the declared convergence point, at which the operational radius is frozen and active monitoring begins. The gray segment is a retrospective continuation obtained by incorporating additional observations known from the benchmark to be healthy; it is shown only to characterize the subsequent behaviour of the estimator and is not used to modify the deployed decision boundary. The horizontal dashed line indicates the complete-data field-oracle p98 reference.\relax }{figure.caption.13}{}}
