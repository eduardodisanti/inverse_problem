\@writefile{toc}{\contentsline {subsection}{\numberline {5.2}Direct simulation-to-field deployment}{10}{subsection.5.2}\protected@file@percent }
\newlabel{sec:shared-deployment-results}{{5.2}{10}{Direct simulation-to-field deployment}{subsection.5.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Simulation-to-field deployment of the shared autoencoder on CWRU. FAR denotes the healthy false-alarm rate and DR the fault detection rate. The field-oracle radius uses every available healthy window; the online radius uses only the first 100 healthy windows. A dash indicates that convergence is not applicable because the threshold is computed directly rather than estimated sequentially.\relax }}{11}{table.caption.10}\protected@file@percent }
\newlabel{tab:shared-deployment}{{2}{11}{Simulation-to-field deployment of the shared autoencoder on CWRU. FAR denotes the healthy false-alarm rate and DR the fault detection rate. The field-oracle radius uses every available healthy window; the online radius uses only the first 100 healthy windows. A dash indicates that convergence is not applicable because the threshold is computed directly rather than estimated sequentially.\relax }{table.caption.10}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.3}Cost of scalable deployment}{11}{subsection.5.3}\protected@file@percent }
\newlabel{sec:deployment-cost}{{5.3}{11}{Cost of scalable deployment}{subsection.5.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Ideal but non-scalable asset-specific deployment versus the proposed fleet-scalable deployment. Values are mean $\pm $ standard deviation across the four CWRU operating conditions.\relax }}{11}{table.caption.11}\protected@file@percent }
\newlabel{tab:oracle-vs-proposed}{{3}{11}{Ideal but non-scalable asset-specific deployment versus the proposed fleet-scalable deployment. Values are mean $\pm $ standard deviation across the four CWRU operating conditions.\relax }{table.caption.11}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.4}Operational-radius convergence}{12}{subsection.5.4}\protected@file@percent }
\newlabel{sec:radius-convergence-results}{{5.4}{12}{Operational-radius convergence}{subsection.5.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Cold-start convergence and retrospective evolution of the local operational radius across the four CWRU operating conditions. The blue segment shows the sequential estimate during the 100-window calibration interval; the red dotted line marks the detected convergence index. The gray segment is retrospective only and is not used by the deployed detector. Horizontal lines indicate $\tau _{\mathrm  {bridge}}$ and the complete-data field p98 reference.\relax }}{12}{figure.caption.12}\protected@file@percent }
\newlabel{fig:tau-convergence}{{4}{12}{Cold-start convergence and retrospective evolution of the local operational radius across the four CWRU operating conditions. The blue segment shows the sequential estimate during the 100-window calibration interval; the red dotted line marks the detected convergence index. The gray segment is retrospective only and is not used by the deployed detector. Horizontal lines indicate $\tau _{\mathrm {bridge}}$ and the complete-data field p98 reference.\relax }{figure.caption.12}{}}
