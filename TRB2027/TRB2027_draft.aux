\@writefile{toc}{\contentsline {subsection}{\numberline {5.3}Direct simulation-to-field deployment}{11}{subsection.5.3}\protected@file@percent }
\newlabel{sec:shared-deployment-results}{{5.3}{11}{Direct simulation-to-field deployment}{subsection.5.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Simulation-to-field deployment of the shared autoencoder on CWRU. FAR denotes healthy false-alarm rate and DR denotes fault detection rate. The field oracle uses every available healthy window, whereas the proposed online procedure stops automatically when the empirical p98 radius satisfies the convergence criterion. Healthy FAR is calculated over the complete healthy dataset to permit direct comparison between calibration strategies. A dash indicates that sequential calibration is not applicable.\relax }}{12}{table.caption.10}\protected@file@percent }
\newlabel{tab:shared-deployment}{{3}{12}{Simulation-to-field deployment of the shared autoencoder on CWRU. FAR denotes healthy false-alarm rate and DR denotes fault detection rate. The field oracle uses every available healthy window, whereas the proposed online procedure stops automatically when the empirical p98 radius satisfies the convergence criterion. Healthy FAR is calculated over the complete healthy dataset to permit direct comparison between calibration strategies. A dash indicates that sequential calibration is not applicable.\relax }{table.caption.10}{}}
